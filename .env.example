# ==============================================
# TalentOS Environment Variables
# ==============================================

# Project & API Configuration
PROJECT_NAME="TalentOS"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/talentos_db"
# If running inside Docker, use:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/talentos_db"

# Cache & Storage
REDIS_URL="redis://localhost:6379/0"
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# AI Intelligence Providers
# ----------------------------------------------------
# 1. Groq (Free & Ultra-Fast inference with Llama 3.3 70B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Optional alternative providers:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
