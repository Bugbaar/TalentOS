diff --git a/backend/main.py b/backend/main.py
index e69de29..7cbbaad 100644
--- a/backend/main.py
+++ b/backend/main.py
@@ -0,0 +1,39 @@
+"""
+TalentOS Backend API entrypoint.
+
+Minimal FastAPI bootstrap so contributors have a working service to run
+locally. Business services (Candidate, Job, Resume, Matching, Analytics)
+should be added as routers under backend/ as they're implemented.
+"""
+
+import os
+
+from fastapi import FastAPI
+
+app = FastAPI(
+    title="TalentOS API",
+    description="Backend API for TalentOS - Talent Intelligence & Hiring Infrastructure",
+    version="0.1.0",
+)
+
+
+@app.get("/")
+def root():
+    return {"service": "talentos-backend", "status": "ok"}
+
+
+@app.get("/health")
+def health():
+    """Basic liveness/readiness check used for local setup verification."""
+    return {
+        "status": "healthy",
+        "database_url_configured": bool(os.getenv("DATABASE_URL")),
+        "redis_url_configured": bool(os.getenv("REDIS_URL")),
+        "qdrant_url_configured": bool(os.getenv("QDRANT_URL")),
+    }
+
+
+if __name__ == "__main__":
+    import uvicorn
+
+    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)
diff --git a/docker-compose.yml b/docker-compose.yml
index e69de29..0e83d81 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -0,0 +1,46 @@
+version: "3.9"
+
+services:
+  postgres:
+    image: postgres:16-alpine
+    container_name: talentos_postgres
+    restart: unless-stopped
+    environment:
+      POSTGRES_USER: talentos
+      POSTGRES_PASSWORD: talentos
+      POSTGRES_DB: talentos
+    ports:
+      - "5432:5432"
+    volumes:
+      - postgres_data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U talentos"]
+      interval: 5s
+      timeout: 5s
+      retries: 5
+
+  redis:
+    image: redis:7-alpine
+    container_name: talentos_redis
+    restart: unless-stopped
+    ports:
+      - "6379:6379"
+    healthcheck:
+      test: ["CMD", "redis-cli", "ping"]
+      interval: 5s
+      timeout: 5s
+      retries: 5
+
+  qdrant:
+    image: qdrant/qdrant:latest
+    container_name: talentos_qdrant
+    restart: unless-stopped
+    ports:
+      - "6333:6333"
+      - "6334:6334"
+    volumes:
+      - qdrant_data:/qdrant/storage
+
+volumes:
+  postgres_data:
+  qdrant_data:
